[Unit]
Description=Mark i3 window urgent on matching RuneLite notifications
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/jk/dotfiles/python
ExecStart=/usr/bin/python3 /home/jk/dotfiles/python/notifications-focus.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
