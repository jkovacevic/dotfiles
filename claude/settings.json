{
  "permissions": {
    "allow": [
      "Read(//home/jk/**)",
      "Read(//etc/**)",
      "Read(//usr/**)",
      "Read(//var/**)",
      "Read(//opt/**)",
      "Read(//tmp/**)",
      "Read(//run/**)",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(id *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(uname *)",
      "Bash(hostname *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(type *)",
      "Bash(ps *)",
      "Bash(pgrep *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(zsh -n *)",
      "Bash(bash -n *)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m json.tool *)",
      "Bash(jq *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/hooks/save-user-history.sh"
          },
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/integration-tmux/status.sh computing"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/integration-tmux/status.sh computing"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/integration-tmux/status.sh prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/integration-tmux/status.sh complete"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/jk/dotfiles/claude/statusline.sh"
  }
}
